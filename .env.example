# Copy to .env and fill in. Never commit .env.

# PostgreSQL started by `make db` (docker compose). Local development password only.
DATABASE_URL=postgresql://aerodoc:aerodoc@localhost:5432/aerodoc

# LLM provider and key. Get a free Gemini key at https://aistudio.google.com (Get API key).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
